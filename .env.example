# Copia este archivo como .env y llena los valores. Nunca subas .env al repositorio.
# La clave service_role de Supabase NO va aquí: jamás llega a la app ni al panel.

# App móvil (Fase 1 en adelante)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Panel web (Fase 1 en adelante)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional. Sin esta clave el mapa móvil usa MapLibre con OpenStreetMap.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
